{
  "manifest_version": 3,
  "name": "You Private 2FA",
  "version": "1.0",
  "author": "Dmitry S", 
  "description": "Локальный автономный генератор 2FA кодов из Google Authenticator",
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon128.png"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "options.html"
}